[Unit]
Description=Kasina Cakery Academy (gunicorn)
After=network.target

[Service]
User=kasina
Group=kasina
WorkingDirectory=/opt/kasina
EnvironmentFile=/etc/kasina.env
ExecStart=/opt/kasina/.venv/bin/gunicorn -w 3 --threads 4 -t 300 -b 127.0.0.1:8000 wsgi:app
Restart=always
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
