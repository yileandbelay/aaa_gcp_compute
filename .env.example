# Settings for one academy. On a server, install.sh copies this to /etc/<name>.env.
# Put values containing spaces in double quotes. Restart the app after changes.

# --- Security & storage -------------------------------------------------------
SECRET_KEY="change-me-to-a-long-random-string"
# SQLite by default. For PostgreSQL / Cloud SQL use e.g.:
# DATABASE_URL="postgresql+psycopg2://academy:PASSWORD@10.0.0.5/academy"
UPLOAD_DIR="/var/lib/academy/uploads"
MAX_UPLOAD_MB=1024
# Set true once the site is served over HTTPS (install.sh does this for you).
SESSION_COOKIE_SECURE=true
BEHIND_PROXY=true

# --- Branding -------------------------------------------------------------------
# Languages offered on the site (translation files in academy/translations/) and the one used
# for first-time visitors. With autodetect on, a visitor whose browser prefers Amharic sees it.
LANGUAGES="en,am"
DEFAULT_LANGUAGE="en"
LANGUAGE_AUTODETECT=true
SITE_NAME="Mek Academy"
SITE_SHORT_NAME="Mek Academy"
SITE_TAGLINE="Professional training you can take anywhere."
SITE_HEADLINE="Build skills that move your career forward."
SITE_INTRO="Practical, professional training taught by experienced teachers. Watch lessons, download materials, test yourself and earn a certificate - on your phone or computer."
# Optional: override the main colour (default is the built-in emerald, #287D63).
# BRAND_COLOR="#287D63"
# Prefix of payment references on receipts, e.g. MEK-1a2b3c4d.
TX_PREFIX="MEK"
# Optional folder that overrides templates/static files (see README "Theme folder").
# THEME_DIR="/opt/academy-themes/mek"
# Shown on the Contact page and the policy pages. Messages sent through the Contact page are
# saved for admins and also emailed to CONTACT_EMAIL (needs the MAIL_* settings below).
CONTACT_EMAIL="info@example.com"
CONTACT_PHONE="+251 9XX XXX XXX"
CONTACT_ADDRESS=""
CONTACT_HOURS=""
# Optional: number with country code (2519...) and Telegram username without @.
CONTACT_WHATSAPP=""
CONTACT_TELEGRAM=""
CONTACT_FORM=true
CONTACT_MAX_PER_HOUR=5

# --- Optional modules -------------------------------------------------------------
FEATURE_DISCUSSION=true
FEATURE_ANNOUNCEMENTS=true
FEATURE_CERTIFICATES=true
FEATURE_REVIEWS=true

# --- Content protection --------------------------------------------------------------
PROTECT_LESSON_TEXT=false
VIDEO_WATERMARK=true
ALLOW_VIDEO_DOWNLOAD=false
ALLOW_MATERIAL_DOWNLOAD=true
# Hosted video (recommended: keeps video traffic off your server). Configure one or both;
# lessons choose their host in the lesson editor. With neither, videos are stored on this server.
#
# Bunny Stream: library ID and the library's API key are on the library's "API" page.
# Turn on "Embed view token authentication" in the library's Security page and put its
# key below, so video links are signed for each student.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_KEY=
# VdoCipher (DRM, burns the student's name into the video). API key: Config > API keys.
VDOCIPHER_API_SECRET=
# nginx streams locally stored videos after the app checks access.
USE_X_ACCEL_REDIRECT=true

# --- Payments -----------------------------------------------------------------------
CURRENCY="ETB"
# Chapa online payments (https://dashboard.chapa.co). Leave empty to disable.
CHAPA_SECRET_KEY=
MANUAL_PAYMENT_ENABLED=true
# How students pay offline (bank, Telebirr, cash) is edited in the app: Admin > Payments > Payment details.
# Only set this line to override it from the server:
# MANUAL_PAYMENT_INSTRUCTIONS="Transfer the fee to ..., then upload your receipt."
# Only for local testing - simulates payments. Never true on a live site.
PAYMENT_DEMO_MODE=false

# --- Email (password resets, payment notices) -------------------------------------------
# Without MAIL_SERVER, emails are only written to the log.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM="Mek Academy <no-reply@example.com>"

# --- Backups ----------------------------------------------------------------------------
# Optional off-server copy of the daily backups (gs://bucket or s3://bucket).
# BACKUP_BUCKET="gs://my-academy-backups"
