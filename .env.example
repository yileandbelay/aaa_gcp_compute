# Copy to .env and fill in. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
# SQLite by default; for production use PostgreSQL / Cloud SQL:
# DATABASE_URL=postgresql+psycopg2://kasina:PASSWORD@10.0.0.5/kasina
UPLOAD_DIR=/var/lib/kasina/uploads
SITE_NAME=Kasina Cakery Academy
CURRENCY=ETB
# Chapa online payments (https://dashboard.chapa.co). Leave empty to disable.
CHAPA_SECRET_KEY=
MANUAL_PAYMENT_ENABLED=true
MANUAL_PAYMENT_INSTRUCTIONS=Transfer the course fee to Kasina Cakery, CBE account 1000XXXXXXXX, or telebirr 09XXXXXXXX, then upload your receipt.
# Only for local testing - simulates payments.
PAYMENT_DEMO_MODE=false
# Set true once HTTPS is enabled.
SESSION_COOKIE_SECURE=true
MAX_UPLOAD_MB=1024
BEHIND_PROXY=true

# Protected video (VdoCipher DRM). API secret from the VdoCipher dashboard > Config > API keys.
VDOCIPHER_API_SECRET=
# Let nginx stream locally stored videos (requires the location in deploy/nginx.conf).
USE_X_ACCEL_REDIRECT=true

# Email for password resets and payment notifications (any SMTP provider).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Kasina Cakery Academy <no-reply@example.com>

# Shown on the terms / privacy / refund pages.
CONTACT_EMAIL=info@example.com
CONTACT_PHONE=+251 9XX XXX XXX

# Optional Cloud Storage bucket for daily backups (deploy/backup.sh).
# BACKUP_BUCKET=gs://my-kasina-backups
